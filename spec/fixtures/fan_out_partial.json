{
  "name": "fan_out returns all results in given order plus failures",
  "mode": "fan_out",
  "args": { "models": ["jev", "jeff", "laya"], "min_success": 2 },
  "request": { "state": "x", "questions": { "q": { "type": "noul", "instructions": "?" } } },
  "mock": {
    "jev":  { "latency_ms": 50, "answers": { "q": { "type": "noul", "noul": 0.9 } } },
    "jeff": { "latency_ms": 5,  "answers": { "q": { "type": "noul", "noul": 0.2 } } },
    "laya": { "error": { "kind": "transport", "message": "connection refused" } }
  },
  "expect": {
    "ok": true,
    "answers": {},
    "results": [ { "model": "jev" }, { "model": "jeff" } ],
    "failures": [ { "model": "laya", "error": { "kind": "transport" } } ]
  }
}
