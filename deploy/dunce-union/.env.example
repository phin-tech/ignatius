# Bearer token clients send to the Ignatius gateway.
IGNATIUS_API_KEY=change-me
# Bearer token the gateway uses to call the model services (kept on the
# compose network; the models are not published).
DUNCE_API_KEY=change-me-too

# Which model services `docker compose up` starts: laya, jeff, kev, jeff-gemma.
# laya has the smallest image; jeff-gemma is 17.7 GB.
COMPOSE_PROFILES=laya

# The gateway publishes on loopback by default.
# IGNATIUS_BIND=127.0.0.1
# IGNATIUS_PORT=8081

# Pin or override images, e.g. to a different Decis release.
# DUNCE_LAYA_IMAGE=chaitin/decis:laya-multilingual-v0.4.0
# DUNCE_JEFF_IMAGE=chaitin/decis:jeff-qwen3.5-0.8b-v0.4.0
# DUNCE_KEV_IMAGE=chaitin/decis:kev-0.8b-v0.4.0
